rules_version = '2';

// ===== REGLAS DE SEGURIDAD DE FIRESTORE - Juan =====
// Cualquiera puede VER el catálogo; solo el personal con sesión iniciada
// puede crear, editar o borrar.
service cloud.firestore {
  match /databases/{database}/documents {

    match /productos/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.precio is number
        && request.resource.data.precio >= 0
        && request.resource.data.cantidad is number
        && request.resource.data.cantidad >= 0;
      allow delete: if request.auth != null;
    }

    match /categorias/{nombre} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Todo lo demás está cerrado
    match /{otro=**} {
      allow read, write: if false;
    }
  }
}
